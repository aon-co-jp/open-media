{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-media",
  "version": "0.1.7",
  "identifier": "jp.co.aon.make-disk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "open-media",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": { "installMode": "currentUser", "template": "../installer/installer.nsi" }
    },
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2RjlCMjVBMDMxNkFFODkKUldTSnJoWURXckw1ZGxxcldXVXNMM05lUmZ0UDBMMDFFcWJDaXZ6MkdHUWZKdzVqSjlZTE04RVIK",
      "endpoints": [
        "https://github.com/aon-co-jp/open-media/releases/latest/download/latest.json"
      ]
    }
  }
}
