# Generated by Cargo
# will have compiled files and executables
/target/

# 自動アップデート署名鍵(2026-09-16追加)。秘密鍵はGitHub Secrets
# (TAURI_SIGNING_PRIVATE_KEY)へ登録済み、リポジトリには絶対にコミット
# しない。公開鍵(updater.key.pub)はtauri.conf.jsonへ埋め込むだけなので
# コミットして問題ない。
/updater.key

# sidecar実行ファイル(ffmpeg/ffprobe、2026-09-14追加)。
# scripts/fetch-ffmpeg-sidecars.shでダウンロードする成果物で、
# リポジトリを肥大化させないためコミットしない(binaries/README.md参照)。
/binaries/*
!/binaries/README.md

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Android Studio project build artifacts (gen/android itself is checked in)
/gen/android/local.properties
/gen/android/**/build/
/gen/android/**/.gradle/
/gen/android/**/.cxx/
/gen/android/.idea/
/gen/android/**/*.iml
